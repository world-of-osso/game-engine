// M2 particle quads composited into the gamma-encoded scene colour by
// rendering/particle_composite_effect.gd. A template, not a Godot-imported .glsl: the
// effect splits the #[vertex] / #[fragment] stages and inserts
// retail_fog.gdshaderinc's functions at #RETAIL_FOG before compiling.
#[vertex]
#version 450
// One instance per quad, four triangle-strip vertices.

layout(set = 0, binding = 0, std140) uniform Scene {
	mat4 view_projection;
	vec4 camera_position;
	vec3 fog_color;
	float fog_density;
	vec3 fog_end_color;
	float fog_height_density;
	vec3 fog_height_color;
	float fog_height;
	vec3 fog_height_end_color;
	float fog_height_rate;
	vec3 fog_sun_color;
	float fog_z_scalar;
	vec3 fog_sun_direction;
	float fog_legacy_scalar;
	vec2 fog_range;
	vec2 fog_main_range;
	vec2 fog_color_range;
	float fog_sun_angle;
	float fog_sun_percentage;
	vec4 fog_height_coefficients;
	vec4 fog_main_coefficients;
	vec4 fog_height_density_coefficients;
};

// particles.rs write_instance: transform rows (basis x/y are the quad half axes, basis
// z holds layer 1's UV offset and the placement fade), colour, then custom (atlas
// cell offset, layer 2's UV offset).
layout(set = 1, binding = 0, std430) restrict readonly buffer Instances {
	vec4 instance_data[];
};

layout(push_constant, std430) uniform Params {
	vec2 cell_size;
	vec2 layer_scale;
	int pixel_shader;
	int gx_blend;
	float alpha_test;
	int fog_mode;
	float fog_opacity;
};

layout(location = 0) out vec2 uv0;
layout(location = 1) out vec2 uv1;
layout(location = 2) out vec2 uv2;
layout(location = 3) out float fade;
layout(location = 4) out vec3 world_position;
layout(location = 5) out vec4 particle_color;

// BuildQuadT3 corners: (-1, 1) samples (0, 0), (1, -1) samples (1, 1).
const vec2 CORNERS[4] = vec2[](vec2(-1.0, 1.0), vec2(-1.0, -1.0), vec2(1.0, 1.0), vec2(1.0, -1.0));

void main() {
	vec2 vertex = CORNERS[gl_VertexIndex];
	int base = gl_InstanceIndex * 5;
	vec4 row0 = instance_data[base];
	vec4 row1 = instance_data[base + 1];
	vec4 row2 = instance_data[base + 2];
	vec4 custom = instance_data[base + 4];
	vec3 axis_x = vec3(row0.x, row1.x, row2.x);
	vec3 axis_y = vec3(row0.y, row1.y, row2.y);
	vec3 axis_z = vec3(row0.z, row1.z, row2.z);
	vec3 origin = vec3(row0.w, row1.w, row2.w);
	vec2 corner = vec2(vertex.x * 0.5 + 0.5, 0.5 - vertex.y * 0.5);
	uv0 = custom.xy + corner * cell_size;
	uv1 = corner * layer_scale.x + axis_z.xy;
	uv2 = corner * layer_scale.y + custom.zw;
	fade = axis_z.z;
	particle_color = instance_data[base + 3];
	world_position = origin + axis_x * vertex.x + axis_y * vertex.y;
	gl_Position = view_projection * vec4(world_position, 1.0);
}

#[fragment]
#version 450

layout(set = 0, binding = 0, std140) uniform Scene {
	mat4 view_projection;
	vec4 camera_position;
	vec3 fog_color;
	float fog_density;
	vec3 fog_end_color;
	float fog_height_density;
	vec3 fog_height_color;
	float fog_height;
	vec3 fog_height_end_color;
	float fog_height_rate;
	vec3 fog_sun_color;
	float fog_z_scalar;
	vec3 fog_sun_direction;
	float fog_legacy_scalar;
	vec2 fog_range;
	vec2 fog_main_range;
	vec2 fog_color_range;
	float fog_sun_angle;
	float fog_sun_percentage;
	vec4 fog_height_coefficients;
	vec4 fog_main_coefficients;
	vec4 fog_height_density_coefficients;
};

layout(push_constant, std430) uniform Params {
	vec2 cell_size;
	vec2 layer_scale;
	int pixel_shader;
	int gx_blend;
	float alpha_test;
	int fog_mode;
	float fog_opacity;
};

// Scene depth after the transparent pass (resolved under MSAA), Godot's reverse Z.
layout(set = 0, binding = 1) uniform sampler2D scene_depth;
layout(set = 1, binding = 1) uniform sampler2D texture_0;
layout(set = 1, binding = 2) uniform sampler2D texture_1;
layout(set = 1, binding = 3) uniform sampler2D texture_2;

layout(location = 0) in vec2 uv0;
layout(location = 1) in vec2 uv1;
layout(location = 2) in vec2 uv2;
layout(location = 3) in float fade;
layout(location = 4) in vec3 world_position;
layout(location = 5) in vec4 particle_color;

layout(location = 0) out vec4 frag_color;

// The effect inserts retail_fog.gdshaderinc's functions here; its uniforms are the
// Scene members and push constants above under the same names.
#RETAIL_FOG

void main() {
	// Behind the opaque scene: the resolved depth is sampled, never attached, so the
	// test is identical with and without MSAA (particles write no depth).
	if (gl_FragCoord.z < texelFetch(scene_depth, ivec2(gl_FragCoord.xy), 0).r) {
		discard;
	}
	vec4 tex = texture(texture_0, uv0);
	if (tex.a < alpha_test) {
		discard;
	}
	// m2ParticleShader.frag.slang: colour x texels in authored space.
	vec4 color = vec4(particle_color.rgb * tex.rgb, tex.a * particle_color.a);
	if (pixel_shader == 1) {
		vec4 modulated = tex * texture(texture_1, uv1);
		color = vec4(particle_color.rgb * modulated.rgb, modulated.a * texture(texture_2, uv2).a * particle_color.a);
	} else if (pixel_shader == 2) {
		vec4 modulated = tex * texture(texture_1, uv1) * texture(texture_2, uv2);
		color = vec4(particle_color.rgb * modulated.rgb, modulated.a * particle_color.a);
	}
	if (color.a < alpha_test) {
		discard;
	}
	vec3 rgb = retail_fog(color.rgb, world_position, camera_position.xyz, gx_blend);
	float alpha = color.a;
	// A fading placement fades its particles; modes that ignore source alpha scale
	// colour toward their identity instead.
	if (gx_blend == 10) {
		// NoAlphaAdd: ONE, ONE.
		rgb *= fade;
	} else if (gx_blend == 4) {
		// Mod: DST_COLOR, ZERO.
		rgb = mix(vec3(1.0), rgb, fade);
	} else if (gx_blend == 5) {
		// Mod2x: DST_COLOR, SRC_COLOR; 0.5 is neutral.
		rgb = mix(vec3(0.5), rgb, fade);
	} else if (gx_blend == 13) {
		// BlendAdd: ONE, ONE_MINUS_SRC_ALPHA over premultiplied output.
		rgb *= fade;
		alpha *= fade;
	} else if (gx_blend >= 2) {
		alpha *= fade;
	}
	// Authored values straight into the gamma-encoded target, as WWV writes its
	// UNORM attachment.
	frag_color = vec4(rgb, alpha);
}
