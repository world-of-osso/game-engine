#!/usr/bin/env bash
# Run a command inside the capped agents.slice, grouped per agent, so that
#   systemctl --user stop agents-<name>.slice   stops everything one agent started
#   systemctl --user stop agents.slice          stops everything every agent started
# and the whole group never takes more than the slice's CPU/memory cap
# (~/.config/systemd/user/agents.slice).
#
# Usage: scripts/agent/agent-run <agent-name> <command> [args...]
# The command runs in the foreground in the current directory with the current
# environment; its output and exit code are passed through.
set -euo pipefail
if [ $# -lt 2 ]; then
    echo "usage: $0 <agent-name> <command> [args...]" >&2
    exit 2
fi
name=$(printf '%s' "$1" | tr -c 'a-zA-Z0-9_\n' '_')
shift
# /tmp is RAM-backed tmpfs; tests copy the 886 MB world.db into temp dirs and filled it (quota
# errors, 2026-10-21). Keep agent temp files on disk. IPC sockets stay in /tmp (hardcoded paths).
export TMPDIR=/var/tmp/agents
mkdir -p "$TMPDIR"
# Concurrent opt-level-2 server_combat compiles (~11 GiB rustc each) OOM-killed the slice on
# 2026-10-29, so cargo waits for a capacity ADD verdict before starting. Other commands
# (servers, clients) start immediately.
capacity=/home/osso/.worktrees/logs/capacity.sh
runs_cargo=""
for arg in "$@"; do [ "$(basename -- "$arg")" = cargo ] && runs_cargo=1 && break; done
if [ -n "$runs_cargo" ] && [ -x "$capacity" ]; then
    until CAPACITY_ID="agent-${name}" "$capacity" | tee /dev/stderr | grep -q '| ADD:'; do :; done
fi
exec systemd-run --user --scope --quiet --collect \
    --slice="agents-${name}.slice" \
    --unit="agent-${name}-$$-${RANDOM}" \
    --nice=10 \
    -- ionice -c 3 "$@"
