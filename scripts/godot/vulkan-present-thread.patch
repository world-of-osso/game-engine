+	// vkQueuePresentKHR runs on a dedicated thread. Without explicit sync, NVIDIA's Wayland WSI
+	// waits inside it for the frame's GPU work, which on the render thread serializes recording
+	// with GPU execution. At most one present is in flight; acquiring, resizing or releasing a
+	// swap chain and freeing a queue wait for it, since present and acquire must be externally
+	// synchronized on the swap chain.
+	struct PresentRequest {
+		Queue *queue = nullptr;
+		LocalVector<VkSemaphore> wait_semaphores;
+		LocalVector<SwapChain *> swap_chains;
+		LocalVector<VkSwapchainKHR> vk_swapchains;
+		LocalVector<uint32_t> image_indices;
+		LocalVector<VkResult> results;
+	};
